# Environment Configuration for Digital Cowboy

# Required for SEO functionality
NEXT_PUBLIC_SITE_URL=https://digitalcowboy.com

# Firebase Configuration (existing)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin (Server-side)
FIREBASE_ADMIN_SDK_KEY=your_admin_key
FIREBASE_ADMIN_DATABASE_URL=your_db_url

# Email Configuration (existing)
RESEND_API_KEY=your_resend_key

# Groq Configuration (existing)
GROQ_API_KEY=your_groq_key
